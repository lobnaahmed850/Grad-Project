    "import numpy as np\n",
    "from sklearn.metrics import classification_report\n",
    "\n",
    "# 1. Get the raw predicted probabilities instead of the final predictions\n",
    "probs = rf_model.predict_proba(X_test)\n",
    "\n",
    "# 2. Use the exact integer indices from your label encoding\n",
    "brute_force_idx = 11\n",
    "sqli_idx = 12\n",
    "xss_idx = 13\n",
    "\n",
    "# 3. Create a weight multiplier array (default is 1.0 for all classes)\n",
    "threshold_weights = np.ones(probs.shape[1])\n",
    "\n",
    "# 4. Apply aggressive multipliers to the Web Attack classes. \n",
    "threshold_weights[sqli_idx] = 5.0        # Extreme boost for the rarest class\n",
    "threshold_weights[xss_idx] = 3.0         # Heavy boost\n",
    "threshold_weights[brute_force_idx] = 2.0 # Moderate boost\n",
    "\n",
    "# 5. Multiply the raw probabilities by your custom weights\n",
    "adjusted_probs = probs * threshold_weights\n",
    "\n",
    "# 6. Make the final prediction based on the adjusted probabilities\n",
    "y_pred_adjusted = np.argmax(adjusted_probs, axis=1)\n",
    "\n",
    "# 7. Evaluate the new results (comparing integer targets to integer predictions)\n",
    "print(\"Results AFTER Threshold Adjustment:\")\n",
    "print(\"-\" * 40)\n",
    "print(classification_report(y_test, y_pred_adjusted,target_names=label_encoder.classes_, zero_division=0))"
   ]
