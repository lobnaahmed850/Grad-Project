    "from sklearn.preprocessing import label_binarize\n",
    "from sklearn.metrics import average_precision_score\n",
    "\n",
    "y_val_pred_smote = rf_model.predict(X_val)\n",
    "y_val_proba = rf_model.predict_proba(X_val)\n",
    "classes = rf_model.classes_\n",
    "\n",
    "val_accuracy = accuracy_score(y_val, y_val_pred_smote)\n",
    "val_precision = precision_score(\n",
    "    y_val,\n",
    "    y_val_pred_smote,\n",
    "    average=\"macro\",\n",
    "    zero_division=0\n",
    ")\n",
    "val_recall = recall_score(\n",
    "    y_val,\n",
    "    y_val_pred_smote,\n",
    "    average=\"macro\",\n",
    "    zero_division=0\n",
    ")\n",
    "val_f1 = f1_score(\n",
    "    y_val,\n",
    "    y_val_pred_smote,\n",
    "    average=\"macro\",\n",
    "    zero_division=0\n",
    ")\n",
    "\n",
    "# PR-AUC (one-vs-rest)\n",
    "y_val_bin = label_binarize(y_val, classes=classes)\n",
    "present = y_val_bin.sum(axis=0) > 0   # only classes present in y_val\n",
    "\n",
    "val_pr_auc_macro = average_precision_score(\n",
